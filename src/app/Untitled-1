// 1. Create a new Next.js 14 project with TypeScript and Tailwind CSS using the App Router
// Run the following commands in your terminal:

npx create-next-app@latest fan-portfolio \
  --typescript \
  --tailwind \
  --app \
  --eslint \
  --src-dir \
  --import-alias "@/*"

// 2. Change into the new project directory
cd fan-portfolio

// 3. (Optional but recommended) Initialize a Git repository
git init

// 4. Run the development server
npm run dev

// The project "fan-portfolio" is now set up with:
// - Next.js 14
// - TypeScript
// - Tailwind CSS
// - App Router (app directory)
// - ESLint
// - Custom import alias "@/*"
// - src/ directory enabled

// You can now visit http://localhost:3000 to view your running app locally.